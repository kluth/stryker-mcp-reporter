{
  "name": "stryker-mcp-reporter",
  "version": "1.4.0",
  "description": "Ein Stryker Reporter Plugin, das Mutation Testing Ergebnisse nativ über das Model Context Protocol (MCP) bereitstellt.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "stryker-mcp-server": "bin/stryker-mcp-server.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc",
    "test": "vitest run",
    "test:e2e": "node e2e-test.js",
    "test:mutation": "stryker run"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "@stryker-mutator/api": "^8.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@stryker-mutator/core": "^8.2.6",
    "express": "^4.21.0",
    "mutation-testing-report-schema": "^3.0.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@stryker-mutator/api": "^8.2.6",
    "@stryker-mutator/vitest-runner": "^8.2.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "rimraf": "^6.0.1",
    "semantic-release": "^24.0.0",
    "stryker-mcp-reporter": "^1.0.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kluth/stryker-mcp-reporter.git"
  },
  "keywords": [
    "stryker",
    "stryker-plugin",
    "stryker-reporter",
    "mutation-testing",
    "mcp",
    "model-context-protocol"
  ],
  "author": "Matthias Kluth",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kluth/stryker-mcp-reporter/issues"
  },
  "homepage": "https://github.com/kluth/stryker-mcp-reporter#readme",
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
