{
  "name": "stryker-mcp-reporter",
  "version": "1.16.1",
  "description": "Ein Stryker Reporter Plugin, das Mutation Testing Ergebnisse nativ über das Model Context Protocol (MCP) bereitstellt.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "bin": {
    "stryker-mcp-server": "dist/cli.js",
    "stryker-mcp-reporter": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:e2e": "node e2e-test.js",
    "test:mutation": "stryker run"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "@stryker-mutator/api": "^9.0.0",
    "@stryker-mutator/core": "^9.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "mutation-testing-report-schema": "^3.9.0",
    "node-notifier": "^10.0.1",
    "rxjs": "^7.8.2",
    "sqlite-vss": "^0.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@stryker-mutator/api": "^9.6.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/node-notifier": "^8.0.5",
    "eslint": "^10.8.1",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "terser": "^5.49.2",
    "tsup": "^8.5.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kluth/stryker-mcp-reporter.git"
  },
  "keywords": [
    "stryker",
    "stryker-plugin",
    "stryker-reporter",
    "mutation-testing",
    "mcp",
    "model-context-protocol"
  ],
  "author": "Matthias Kluth",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kluth/stryker-mcp-reporter/issues"
  },
  "homepage": "https://github.com/kluth/stryker-mcp-reporter#readme",
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.27.7": true
  }
}
